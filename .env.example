# Optional: External LLM API Key (if omitted, Revilen runs in offline/mock demo mode)
AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Optional: Model selection (defaults to gemini-1.5-flash)
AI_MODEL=gemini-1.5-flash
AI_BASE_URL=

# App Port
PORT=3000
